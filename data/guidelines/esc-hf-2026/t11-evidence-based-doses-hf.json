  "footnotes": {
    "a": {
      "en": "Indicates an ACE-I where the dosing target is derived from post-MI trials.",
      "ru": "Указывает на ингибитор АПФ, целевая доза которого была определена в постинфарктных исследованиях."
    },
    "b": {
      "en": "Indicates drugs where a higher dose has been shown to reduce morbidity/mortality compared with a lower dose of the same drug, but there is no substantive randomized, placebo-controlled trial and the optimal dose is uncertain.",
      "ru": "Указывает на препараты, для которых более высокая доза продемонстрировала снижение заболеваемости/смертности по сравнению с более низкой дозой того же препарата, однако крупные рандомизированные плацебо-контролируемые исследования отсутствуют, и оптимальная доза остается неопределенной."
    },
    "c": {
      "en": "Sacubitril–valsartan may have an optional lower starting dose of 24/26 mg twice daily for those with a history of symptomatic hypotension, ACE-I naive patients and patients with eGFR 30–60 mL/min/1.73 m².",
      "ru": "Сакубитрил/валсартан может иметь опциональную более низкую стартовую дозу 24/26 мг 2 раза в сутки у пациентов с симптоматической гипотензией в анамнезе, пациентов, ранее не принимавших иАПФ, и пациентов с рСКФ 30–60 мл/мин/1,73 м²."
    },
    "d": {
      "en": "A maximum dose of 50 mg twice daily can be administered to patients weighing over 85 kg.",
      "ru": "Максимальная доза 50 мг 2 раза в сутки может назначаться пациентам с массой тела более 85 кг."
    },
    "e": {
      "en": "Indicates a treatment not shown to reduce CV or all-cause death in patients with heart failure (or shown to be non-inferior to a treatment that does).",
      "ru": "Указывает на лечение, для которого не было доказано снижение сердечно-сосудистой или общей смертности у пациентов с сердечной недостаточностью (или показана сопоставимая эффективность с терапией, снижающей ее)."
    },
    "f": {
      "en": "Spironolactone has an optional starting dose of 12.5 mg in patients where kidney status or hyperkalaemia warrant caution.",
      "ru": "Спиронолактон имеет опциональную стартовую дозу 12,5 мг у пациентов, у которых состояние функции почек или гиперкалиемия требуют осторожности."
    },
    "g": {
      "en": "Finerenone has a different starting and target dose according to eGFR (10–20 mg, if eGFR ≤60 mL/min/1.73 m²; 20–40 mg, if eGFR >60 mL/min/1.73 m²).",
      "ru": "Финеренон имеет различные стартовые и целевые дозы в зависимости от рСКФ (10–20 мг при рСКФ ≤60 мл/мин/1,73 м²; 20–40 мг при рСКФ >60 мл/мин/1,73 м²)."
    },
    "h": {
      "en": "Digoxin/digitoxin should be titrated according to plasma levels.",
      "ru": "Доза дигоксина/дигитоксина должна титроваться под контролем концентрации в плазме крови."
    }
  }
}
