      "id": "r01-ezetimibe",
      "cells": [
        {
          "text": {
            "en": "Ezetimibe^[a]",
            "ru": "Эзетимиб^[a]"
          }
        },
        {
          "text": {
            "en": "Blocks NPC1L1 cholesterol absorption",
            "ru": "Блокирует всасывание холестерина через транспортер NPC1L1 в тонком кишечнике"
          }
        },
        {
          "text": {
            "en": "15-25",
            "ru": "15–25"
          }
        },
        {
          "text": {
            "en": "Yes (<10 d post ACS)",
            "ru": "Да (<10 дней после ОКС [исследование IMPROVE-IT])"
          }
        },
        {
          "text": {
            "en": "Liver function test abnormalities",
            "ru": "Отклонения печеночных проб (повышение трансаминаз)"
          }
        }
      ]
    },
    {
