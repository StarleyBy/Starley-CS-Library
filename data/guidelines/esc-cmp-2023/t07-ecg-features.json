      "cells": [
        { "text": { "en": "**HCM**", "ru": "**ГКМП**" } },
        { "text": { "en": "Short PR interval / pre-excitation", "ru": "Укорочение интервала PR / феномен предвозбуждения" } },
        { "text": { "en": "• Glycogenosis\n• Danon disease\n• PRKAG2 cardiomyopathy\n• Anderson–Fabry disease\n• Mitochondrial disease", "ru": "• Гликогенозы\n• Болезнь Данона\n• Кардиомиопатия PRKAG2\n• Болезнь Андерсона–Фабри\n• Митохондриальные болезни" } }
      ]
    },
    {
      "id": "r02",
      "cells": [
        { "text": { "en": "HCM", "ru": "ГКМП" } },
        { "text": { "en": "AV block", "ru": "Атриовентрикулярная (АВ) блокада" } },
        { "text": { "en": "• Amyloidosis\n• Anderson–Fabry disease (late stage)\n• Danon disease\n• Sarcoidosis\n• PRKAG2 cardiomyopathy", "ru": "• Амилоидоз сердца\n• Болезнь Андерсона–Фабри (поздняя стадия)\n• Болезнь Данона\n• Саркоидоз\n• Кардиомиопатия PRKAG2" } }
      ]
    },
    {
      "id": "r03",
      "cells": [
        { "text": { "en": "HCM", "ru": "ГКМП" } },
        { "text": { "en": "Extreme LVH", "ru": "Экстремальная гипертрофия ЛЖ (высокий вольтаж)" } },
        { "text": { "en": "• Danon disease\n• Glycogenosis (e.g. Pompe disease)\n• PRKAG2 cardiomyopathy", "ru": "• Болезнь Данона\n• Гликогенозы (напр., болезнь Помпе)\n• Кардиомиопатия PRKAG2" } }
      ]
    },
    {
      "id": "r04",
      "cells": [
        { "text": { "en": "HCM", "ru": "ГКМП" } },
        { "text": { "en": "Low QRS voltage^[a]", "ru": "Низкий вольтаж зубцов QRS^[a]" } },
        { "text": { "en": "• Amyloidosis\n• Friedreich ataxia", "ru": "• Амилоидоз сердца\n• Атаксия Фридрейха" } }
      ]
    },
    {
      "id": "r05",
      "cells": [
        { "text": { "en": "HCM", "ru": "ГКМП" } },
        { "text": { "en": "Superior QRS axis ('northwest axis')", "ru": "Резкое отклонение ЭОС вверх («северо-западная ось»)" } },
        { "text": { "en": "Noonan syndrome", "ru": "Синдром Нунан" } }
      ]
    },
    {
      "id": "r06",
      "cells": [
        { "text": { "en": "HCM", "ru": "ГКМП" } },
        { "text": { "en": "Q waves / pseudoinfarction pattern", "ru": "Патологические зубцы Q / псевдоинфарктный рубец" } },
