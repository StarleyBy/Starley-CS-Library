          "tone": "yellow"
        }
      ]
    },
    {
      "id": "row-milrinone",
      "cells": [
        { "text": { "en": "**Milrinone**", "ru": "**Милринон**" } },
        { "text": { "en": "NR", "ru": "Не реком." } },
        { "text": { "en": "0.125–0.75 mcg/kg/min", "ru": "0,125–0,75 мкг/кг/мин" } },
        { "text": { "en": "t½: 2.5 h (hepatic)", "ru": "T½: 2,5 ч (печень)" } },
        { "text": { "en": "↑", "ru": "↑" }, "tone": "green" },
        { "text": { "en": "↑", "ru": "↑" }, "tone": "yellow" },
        { "text": { "en": "↓", "ru": "↓" }, "tone": "blue" },
        { "text": { "en": "↓", "ru": "↓" }, "tone": "blue" },
        { "text": { "en": "T, ↓BP", "ru": "Тахиаритмии, гипотензия" } },
        { "text": { "en": "Accumulation may occur in renal failure; monitor renal and LFTs", "ru": "Кумулирует при почечной недостаточности; мониторировать функцию почек и печени" } }
