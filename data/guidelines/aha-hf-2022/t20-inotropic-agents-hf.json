      ]
    },
    {
      "id": "row-dopamine-med",
      "cells": [
        { "text": { "en": "**Dopamine** (medium dose)", "ru": "**Дофамин** (средние дозы)" } },
        { "text": { "en": "NA", "ru": "Н/П" } },
        { "text": { "en": "5–10 mcg/kg/min", "ru": "5–10 мкг/кг/мин" } },
        { "text": { "en": "t½: 2–20 min", "ru": "T½: 2–20 мин" } },
        { "text": { "en": "↑", "ru": "↑" }, "tone": "green" },
        { "text": { "en": "↑", "ru": "↑" }, "tone": "yellow" },
        { "text": { "en": "↔", "ru": "↔" } },
        { "text": { "en": "↔", "ru": "↔" } },
        { "text": { "en": "T, HA, N, tissue necrosis", "ru": "Тахиаритмии, головная боль, тошнота, некроз тканей" } },
        { "text": { "en": "Caution: MAO-I", "ru": "Осторожно при приёме ингибиторов МАО" } }
      ]
    },
    {
      "id": "row-dopamine-high",
      "cells": [
        { "text": { "en": "**Dopamine** (high dose)", "ru": "**Дофамин** (высокие дозы)" } },
        { "text": { "en": "NA", "ru": "Н/П" } },
        { "text": { "en": "10–15 mcg/kg/min", "ru": "10–15 мкг/кг/мин" } },
        { "text": { "en": "R, H, P", "ru": "Почечный, печёночный, плазма" } },
        { "text": { "en": "↑", "ru": "↑" }, "tone": "green" },
        { "text": { "en": "↑", "ru": "↑" }, "tone": "yellow" },
        { "text": { "en": "↑", "ru": "↑" }, "tone": "orange" },
        { "text": { "en": "↔", "ru": "↔" } },
        { "text": { "en": "T, HA, N, tissue necrosis", "ru": "Тахиаритмии, головная боль, тошнота, некроз тканей" } },
        { "text": { "en": "Caution: MAO-I", "ru": "Осторожно при приёме ингибиторов МАО" } }
      ]
    },
    {
      "id": "row-dobutamine",
      "cells": [
        { "text": { "en": "**Dobutamine**", "ru": "**Добутамин**" } },
        { "text": { "en": "NA", "ru": "Н/П" } },
        { "text": { "en": "2.5–20 mcg/kg/min", "ru": "2,5–20 мкг/кг/мин" } },
        { "text": { "en": "t½: 2–3 min (hepatic)", "ru": "T½: 2–3 мин (печень)" } },
        { "text": { "en": "↑", "ru": "↑" }, "tone": "green" },
        { "text": { "en": "↑", "ru": "↑" }, "tone": "yellow" },
        { "text": { "en": "↔", "ru": "↔" } },
        { "text": { "en": "↔", "ru": "↔" } },
        { "text": { "en": "↑/↓BP, HA, T, N, F, hypersensitivity", "ru": "↑/↓ АД, головная боль, тахиаритмии, тошнота, лихорадка, аллергия" } },
        { "text": { "en": "Caution: MAO-I; CI: sulfite allergy", "ru": "Осторожно с ИМАО; противопоказан при аллергии на сульфиты" } }
      ]
